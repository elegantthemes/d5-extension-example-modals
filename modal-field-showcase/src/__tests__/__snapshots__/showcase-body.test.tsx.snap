// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`ShowcaseBody tab panel fragment renders tabs, content panel group, and footer actions 1`] = `"<div data-testid="modal-tabs"><button type="button" data-testid="modal-tab" data-active="true">Content &amp; labels</button><button type="button" data-testid="modal-tab" data-active="false">Appearance tokens</button></div><div data-testid="modal-body"><div data-testid="modal-panel" id="field-showcase-panel" data-opened="true"><div class="field-showcase-infobox" role="note"><div class="field-showcase-infobox__action"><button type="button" data-testid="help-button">?</button></div><p class="field-showcase-infobox__text">HelpButton is for demo. Connect onHelpClick to your help action.</p></div><input data-testid="modal-search" placeholder="Filter settings…" readonly=""/><div class="et-vb-modal-panel et-vb-active"><section data-testid="modal-group" id="field-showcase-group-copy" data-title="Labels &amp; copy"><div data-testid="field-wrapper" data-label="Label prefix (Text)"><input data-testid="field-text" readonly="" value=""/></div><div data-testid="field-wrapper" data-label="Design notes (TextArea)"><input data-testid="field-textarea" readonly="" value=""/></div></section><section data-testid="modal-group" id="field-showcase-group-layout" data-title="Layout mode"><div data-testid="field-wrapper" data-label="Layout density (Select)"><input data-testid="field-select" readonly="" value="comfortable"/></div><div data-testid="field-wrapper" data-label="Enable polish pass (Toggle)"><input data-testid="field-toggle" readonly="" value="off"/></div></section></div><div class="et-vb-modal-panel" hidden=""></div></div></div><footer data-testid="modal-footer"><button type="button" data-testid="footer-discard">Discard changes</button><button type="button" data-testid="footer-save">Save to post</button></footer>"`;
